    pointerOffset: {x: 0, y: 0}
    trigger: 2
    eventName: killMonster
  - dialogue: "\uC88B\uC544\uC694! \uC544\uC8FC \uC798\uD588\uC5B4\uC694. \uC9C0\uAE08\uC740
      \uC791\uC740 \uBB38\uC5B4\uB9CC \uC7A1\uC744 \uC218 \uC788\uC9C0\uB9CC\u2026\r\n\uCE90\uB9AD\uD130\uB97C
      \uAC15\uD654\uD558\uBA74, \uC5B8\uC820\uAC00\uB294 \uBB38\uC5B4\uB4E4\uC758
      \uBCF4\uC2A4\uB3C4 \uC7A1\uC744 \uC218 \uC788\uB2F5\uB2C8\uB2E4."
    questText: 
    characterName: "\uC778\uC2F1\uC7AC"
    characterNameColor: {r: 0.54901963, g: 0.3137255, b: 0.6666667, a: 1}
    characterSprite: {fileID: 21300000, guid: 7875404be415a764f97a234995c4e070, type: 3}
    isLeftCharacter: 0
    isButtonStep: 0
    targetButtonName: 
    pointerOffset: {x: 0, y: 0}
    trigger: 0
    eventName: 
  - dialogue: "\uB358\uC804\uB9C8\uB2E4 \uBCF4\uC2A4 \uBAAC\uC2A4\uD130\uAC00 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uBCF4\uC2A4
      \uBAAC\uC2A4\uD130\uB97C \uC7A1\uC73C\uBA74 \uC77C\uBC18 \uBAAC\uC2A4\uD130\uBCF4\uB2E4
      \uD6E8\uC52C \uD48D\uC131\uD55C \uBCF4\uC0C1\uC744 \uC5BB\uC744 \uC218 \uC788\uC73C\uB2C8,
      \uB098\uC911\uC5D0 \uAF2D \uB3C4\uC804\uD574\uBCF4\uC138\uC694."
    questText: 
    characterName: "\uC778\uC2F1\uC7AC"
    characterNameColor: {r: 0.54901963, g: 0.3137255, b: 0.6666667, a: 1}
    characterSprite: {fileID: 21300000, guid: 7875404be415a764f97a234995c4e070, type: 3}
