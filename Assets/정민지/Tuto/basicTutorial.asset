    targetButtonName: 
    pointerOffset: {x: 0, y: 0}
    trigger: 0
    eventName: 
  - dialogue: "\uC55E\uC73C\uB85C \uB9C8\uB9AC\uB098\uC591\uC774 \uD574\uC57C \uD560
      \uC77C\uB4E4\uC744 \uD558\uB098\uC529 \uC54C\uB824\uB4DC\uB9B4 \uD14C\uB2C8,
      \uC798 \uB530\uB77C\uC624\uC138\uC694."
