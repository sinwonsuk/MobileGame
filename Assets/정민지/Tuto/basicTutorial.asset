    pointerOffset: {x: -60, y: -50}
    trigger: 1
    eventName: 
  - dialogue: "\uBA40\uB9AC\uC11C \uBAAC\uC2A4\uD130\uB4E4\uC774 \uB2E4\uAC00\uC624\uACE0
      \uC788\uB124\uC694.\r\n\uC774 \uB140\uC11D\uB4E4\uC774 \uB9C8\uB9AC\uB098\uC591\uC5D0\uAC8C
      \uB2FF\uAE30 \uC804\uC5D0, \uD30C\uC774\uC5B4\uBCFC\uB85C \uCC98\uCE58\uD574\uC57C
      \uD569\uB2C8\uB2E4."
    questText: 
    characterName: "\uC778\uC2F1\uC7AC"
    characterNameColor: {r: 0.54901963, g: 0.3137255, b: 0.6666667, a: 1}
