    isLeftCharacter: 0
    isButtonStep: 0
    targetButtonName: 
    pointerOffset: {x: 0, y: 0}
    trigger: 0
    eventName: 
  - dialogue: "\uD30C\uC774\uC5B4\uBCFC\uC740 \uC790\uB3D9\uC73C\uB85C \uBC1C\uC0AC\uB418\uC9C0\uB9CC,
      \uC9C1\uC811 \uD130\uCE58\uD574\uC11C \uC3D8\uB294 \uAC83\uB3C4 \uAC00\uB2A5\uD569\uB2C8\uB2E4.\r\n\uD55C\uBC88
      \uC2DC\uB3C4\uD574\uBCFC\uB798\uC694?"
    questText: 
    characterName: "\uC778\uC2F1\uC7AC"
    characterNameColor: {r: 0.54901963, g: 0.3137255, b: 0.6666667, a: 1}
