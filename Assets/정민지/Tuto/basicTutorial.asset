    isButtonStep: 0
    targetButtonName: 
    pointerOffset: {x: 0, y: 0}
    trigger: 0
    eventName: 
  - dialogue: "\uC7AC\uB8CC\uAC00 \uC5B4\uB290 \uC815\uB3C4 \uBAA8\uC778 \uAC83 \uAC19\uB124\uC694.\r\n\uB2E4\uC2DC
