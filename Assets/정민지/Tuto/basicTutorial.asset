    targetButtonName: 
    pointerOffset: {x: 0, y: 0}
    trigger: 0
    eventName: 
  - dialogue: "\uC7AC\uB8CC\uB97C \uAD6C\uD558\uB7EC \uB358\uC804\uC73C\uB85C \uAC00\uC57C\uACA0\uB124\uC694."
