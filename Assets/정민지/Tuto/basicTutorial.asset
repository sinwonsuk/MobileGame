    eventName: 
  - dialogue: "\uC88B\uC740 \uC544\uCE68\uC774\uC5D0\uC694, \uB9C8\uB9AC\uB098\uC591.\n\uCCAB
      \uCD9C\uADFC\uC744 \uC9C4\uC2EC\uC73C\uB85C \uCD95\uD558\uD569\uB2C8\uB2E4."
