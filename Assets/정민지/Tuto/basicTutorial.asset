    pointerOffset: {x: 0, y: 0}
    trigger: 0
    eventName: 
  - dialogue: "\uD654\uBA74\uC744 \uD130\uCE58\uD574\uC11C \uBAAC\uC2A4\uD130\uB97C
      \uC7A1\uC544\uBCF4\uC138\uC694."
    questText: "\uD654\uBA74\uC744 \uD130\uCE58\uD558\uC5EC \uBAAC\uC2A4\uD130\uB97C
      \uC7A1\uC544\uBCF4\uC790."
    characterName: "\uC778\uC2F1\uC7AC"
