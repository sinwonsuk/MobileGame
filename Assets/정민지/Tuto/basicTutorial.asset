    trigger: 0
    eventName: 
  - dialogue: "\uBA3C\uC800 \uC694\uB9AC\uC5D0 \uD544\uC694\uD55C \uC7AC\uB8CC\uAC00
      \uD544\uC694\uD558\uACA0\uC8E0?\r\n\uC6B0\uB9AC \uC2DD\uB2F9\uC740 \uB2E8 \uD558\uB098,
      \uC9C1\uC811 \uC7A1\uC740 \uBAAC\uC2A4\uD130\uB9CC \uC7AC\uB8CC\uB85C \uC4F0\uB294
      \uAC78 \uC6D0\uCE59\uC73C\uB85C \uD569\uB2C8\uB2E4.\r"
    questText: 
    characterName: "\uC778\uC2F1\uC7AC"
