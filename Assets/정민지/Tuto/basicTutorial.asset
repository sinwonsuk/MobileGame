    trigger: 1
    eventName: 
  - dialogue: "\uB9C8\uB9AC\uB098\uC591\uC740 \uC544\uC9C1 \uCD08\uBCF4\uC774\uB2C8,
      \uAC00\uC7A5 \uC7A1\uAE30 \uC26C\uC6B4 \uBB38\uC5B4\uBD80\uD130 \uC2DC\uC791\uD569\uC2DC\uB2E4."
